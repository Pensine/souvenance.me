# PostgreSQL (docker-compose)
POSTGRES_PASSWORD=changeme
PENSINE_DB_PORT=5432              # host port — change it if 5432 is already taken (another Postgres)

# Pensine — identity
PENSINE_OWNER_NAME=               # your first name (used by the consolidation prompts)

# Database and storage (the port must match PENSINE_DB_PORT)
PENSINE_DATABASE_URL=postgresql://pensine:changeme@127.0.0.1:5432/pensine
PENSINE_MEDIA_ROOT=/var/lib/pensine/media
# Data root (media, GeoNames, backups, logs). Empty = automatic choice:
# /var/lib/pensine on a Linux server, otherwise
# ~/Library/Application Support/Souvenance (macOS) or ~/.local/share/souvenance.
# PENSINE_MEDIA_ROOT, PENSINE_GEO_DIR, PENSINE_BACKUP_DIR and PENSINE_LOG_DIR,
# if set, each override the root.
# PENSINE_DATA_DIR=

# Security
PENSINE_DEPOSIT_TOKEN=            # token of the iOS "Pensine" shortcut (openssl rand -hex 32)
PENSINE_MEDIA_LINK_SECRET=        # secret of the re-immersion links (openssl rand -hex 32)
PENSINE_MEDIA_LINK_TTL_S=900
PENSINE_PUBLIC_BASE_URL=https://pensine.example.org

# Compute — 'claude-cli' (Max/Pro subscription via Claude Code) or 'api'
PENSINE_LLM_BACKEND=claude-cli
PENSINE_LLM_MODEL=claude-sonnet-5-5
# If `claude` on the PATH is not the CLI (macOS: the desktop app installs a
# binary of the same name that opens a window instead of answering):
# PENSINE_CLAUDE_BIN=/path/to/the/cli/claude
PENSINE_ANTHROPIC_API_KEY=        # only if backend=api
# 'openai' backend: any server compatible with /v1/chat/completions — local
# model (LM Studio, mlx_lm.server, llama.cpp, vLLM, Ollama /v1) or online
# service (OpenAI, Mistral…). The model must be named, it has no default.
# PENSINE_LLM_BACKEND=openai
# PENSINE_LLM_BASE_URL=http://127.0.0.1:1234/v1
# PENSINE_LLM_MODEL=qwen3-30b-a3b
# PENSINE_LLM_API_KEY=            # optional when local
# PENSINE_VISION_MODEL=           # model for image descriptions (openai, ollama); empty = the same
# PENSINE_LLM_JSON_MODE=auto      # ask the server for a JSON object when one is expected; off = never

# Nightly consolidation — an unreadable answer is asked again (ATTEMPTS calls
# in all), then the night is split down to single deposits; what still fails
# stays pending for the next night.
# PENSINE_CONSOLIDATION_ATTEMPTS=2
# PENSINE_CONSOLIDATION_MAX_EVENTS=0   # deposits per call, 0 = the whole night
# PENSINE_MEMORY_LANGUAGE=source       # source = the deposit's language; or fr, en…

# Local embeddings — 0 to degrade to full-text search
PENSINE_EMBEDDINGS=1

# Voice-note transcription: whisperx | faster-whisper | mlx-whisper | none.
# Empty = the first one installed. Empty model and device = chosen according
# to the machine (WhisperX without a GPU: large-v3, cpu, int8).
# PENSINE_TRANSCRIBE_BACKEND=
# PENSINE_WHISPER_MODEL=
# PENSINE_WHISPER_DEVICE=           # cpu | cuda
# PENSINE_TRANSCRIBE_LANGUAGE=      # empty = automatic detection
# 'nomic' (768-d, ~500 MB of RAM — default) or 'bge-m3' (1024-d, ~2 GB, better
# in French). Changing backend requires migrating the dimension of the
# memories.embedding column and rerunning consolidation to re-embed.
PENSINE_EMBEDDING_BACKEND=nomic

# MCP server: stdio (local dev) or streamable-http (claude.ai connector)
PENSINE_MCP_TRANSPORT=streamable-http

# Listen address of the services (API :8300, MCP :8400) — 127.0.0.1 by default.
# If your reverse proxy runs in a Docker container, put the bridge's gateway
# (e.g. 172.18.0.1) so that it can reach the host's services.
PENSINE_BIND_HOST=127.0.0.1

# Timeline web app (https://your.domain/app) — empty = disabled
PENSINE_WEBAPP_PASSWORD=

# Perceptors (opt-in: empty = inactive)
PENSINE_CALENDAR_ICS_URLS=        # private ICS URL(s) of the calendar, comma-separated
PENSINE_IMAP_HOST=                # personal email (phase 2) — empty = disabled
PENSINE_IMAP_USER=
PENSINE_IMAP_PASSWORD=
PENSINE_IMAP_FOLDER=INBOX
