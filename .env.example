# PostgreSQL (docker-compose)
POSTGRES_PASSWORD=changeme
PENSINE_DB_PORT=5432              # port hôte — changez-le si 5432 est déjà pris (autre Postgres)

# Pensine — identité
PENSINE_OWNER_NAME=               # votre prénom (utilisé par les prompts de consolidation)

# Base et stockage (le port doit correspondre à PENSINE_DB_PORT)
PENSINE_DATABASE_URL=postgresql://pensine:changeme@127.0.0.1:5432/pensine
PENSINE_MEDIA_ROOT=/var/lib/pensine/media

# Sécurité
PENSINE_DEPOSIT_TOKEN=            # token du raccourci iOS « Pensine » (openssl rand -hex 32)
PENSINE_MEDIA_LINK_SECRET=        # secret des liens de replongée (openssl rand -hex 32)
PENSINE_MEDIA_LINK_TTL_S=900
PENSINE_PUBLIC_BASE_URL=https://pensine.example.org

# Compute — 'claude-cli' (abonnement Max/Pro via Claude Code) ou 'api'
PENSINE_LLM_BACKEND=claude-cli
PENSINE_LLM_MODEL=claude-sonnet-5
PENSINE_ANTHROPIC_API_KEY=        # seulement si backend=api

# Embeddings locaux — 0 pour dégrader en recherche plein-texte
PENSINE_EMBEDDINGS=1
# 'nomic' (768-d, ~500 Mo de RAM — défaut) ou 'bge-m3' (1024-d, ~2 Go, meilleur
# en français). Changer de backend impose de migrer la dimension de la colonne
# memories.embedding et de relancer la consolidation pour réembedder.
PENSINE_EMBEDDING_BACKEND=nomic

# Serveur MCP : stdio (dev local) ou streamable-http (connecteur claude.ai)
PENSINE_MCP_TRANSPORT=streamable-http

# Adresse d'écoute des services (API :8300, MCP :8400) — 127.0.0.1 par défaut.
# Si votre reverse proxy tourne en conteneur Docker, mettez la passerelle du
# bridge (ex. 172.18.0.1) pour qu'il joigne les services de l'hôte.
PENSINE_BIND_HOST=127.0.0.1

# Web app timeline (https://votre.domaine/app) — vide = désactivée
PENSINE_WEBAPP_PASSWORD=

# Percepteurs (opt-in : vides = inactifs)
PENSINE_CALENDAR_ICS_URLS=        # URL(s) ICS privée(s) de l'agenda, séparées par des virgules
PENSINE_IMAP_HOST=                # mails personnels (phase 2) — vide = désactivé
PENSINE_IMAP_USER=
PENSINE_IMAP_PASSWORD=
PENSINE_IMAP_FOLDER=INBOX
