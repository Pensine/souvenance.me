# Pensine — reverse proxy (Caddy: automatic HTTPS via Let's Encrypt)
# Replace pensine.example.org with your domain (pointed at the VPS).

pensine.example.org {
    # Deposit API (iOS shortcut) + re-immersion — auth by application token
    handle /deposit {
        reverse_proxy 127.0.0.1:8300
    }
    handle /media/* {
        reverse_proxy 127.0.0.1:8300
    }

    # Timeline web app (auth by application password: PENSINE_WEBAPP_PASSWORD)
    handle /app* {
        reverse_proxy 127.0.0.1:8300
    }

    # MCP server (claude.ai) — an intimate memory is not exposed bare:
    # PENSINE_MCP_TOKEN set: the server requires the token itself (Bearer
    # or /mcp/<token>). Otherwise, an IP allowlist or basic auth at minimum.
    # WARNING: without one of these protections, do not expose /mcp.
    handle /mcp* {
        # basicauth {
        #     pensine $2a$14$...   # caddy hash-password
        # }
        reverse_proxy 127.0.0.1:8400
    }
}
